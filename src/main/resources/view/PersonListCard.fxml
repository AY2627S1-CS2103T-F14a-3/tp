<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
      </HBox>
      <FlowPane fx:id="tags" />
      <!-- Academic Information -->
      <VBox spacing="5" maxWidth="Infinity" styleClass="student-information-box">
        <Label text="Academic Information" styleClass="student-section-title" />
        <Label fx:id="schoolLevel" styleClass="cell_small_label" />
        <Label fx:id="subject" styleClass="cell_small_label" />
      </VBox>

      <!-- Contact Information -->
      <VBox spacing="5" maxWidth="Infinity" styleClass="student-information-box">
        <Label text="Contact Details" styleClass="student-section-title" />
        <Label fx:id="phone" styleClass="cell_small_label" />
        <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
        <Label fx:id="address" styleClass="cell_small_label" text="\$address" />
      </VBox>

      <!-- Next Lesson -->
      <VBox spacing="5" maxWidth="Infinity" styleClass="student-information-box">
        <Label text="Tutoring Information" styleClass="student-section-title" />
        <Label fx:id="nextLesson" styleClass="cell_small_label" text="\$nextLesson" />
        <Label fx:id="nextLessonTopic" styleClass="cell_small_label" text="\$nextLessonTopic" wrapText="true" />
        <Label fx:id="recurringLesson" styleClass="cell_small_label" text="\$recurringLesson" />
        <Label fx:id="recurringLessonTopic" styleClass="cell_small_label" text="\$recurringLessonTopic"
               wrapText="true" />
        <Label fx:id="note" styleClass="cell_small_label" text="\$note" wrapText="true" />
      </VBox>

    </VBox>
  </GridPane>
</HBox>
